// Usamos delegación en el document por si el menú se carga dinámicamente
$(document).on('click', '#btnLogout', function(event) {
    event.preventDefault();
    console.log("Logout button clicked"); // Para verificar en Consola (F12)

    let formData = new FormData();
    formData.append('action', 'logout');

    // Intentamos con la ruta relativa al root
    fetch('_controller/LoginAsync.php', {
        method: 'POST',
        body: formData
    })
    .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.json();
    })
    .then(data => {
        console.log("Response received:", data);
        if(data.result === 1) {
            // Usamos replace("") para recargar la raíz del sitio
            location.replace(""); 
        } else {
            Swal.fire("Error", data.msg, "error");
        }
    })
    .catch(error => {
        console.error('Error detail:', error);
        // Si falla la ruta anterior, intentamos subir un nivel (común en MVC)
        console.log("Retrying with parent path...");
        // fetch('../_controller/LoginAsync.php', ... ) // Solo si la estructura lo requiere
    });
});